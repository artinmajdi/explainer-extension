{
  "name": "explainer-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts tests/nano.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
